{
  "name": "flatpax-planner-wrapper",
  "version": "0.1.0",
  "description": "Wrapper library for Three Configurator with additional features and enhancements",
  "private": true,
  "type": "module",

  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },

  "files": [
    "dist"
  ],

  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run typecheck && vite build && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "prepack": "npm run build"
  },

  "dependencies": {
    "three-configurator": "file:../../configurator-library"
  },

  "peerDependencies": {
    "three": "^0.176.0"
  },

  "bundleDependencies": [
    "three-configurator"
  ],

  "devDependencies": {
    "@types/node": "^22.15.12",
    "@types/three": "^0.176.0",
    "three": "^0.176.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}