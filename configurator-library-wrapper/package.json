{
  "name": "configurator-library-wrapper",
  "version": "0.1.0",
  "type": "module",
  "description": "Simple application wrapper for three-configurator",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "three-configurator": "file:../../configurator-library"
  },
  "devDependencies": {
    "vite": "8.3.3",
    "typescript": "5.9.3",
    "@types/node": "^24.19.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
