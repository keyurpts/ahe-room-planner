{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.docs.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "out": "docs/api",
  "docsRoot": "docs",

  "readme": "none",
  "githubPages": false,
  "hideGenerator": true,

  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "externalPattern": ["**/node_modules/**"],
  "exclude": [
    "**/types/types.ts",
    "**/Constants.ts",
    "**/shapeTemplates.ts",
    "**/event/**"
  ],

  "sort": ["alphabetical"],
  "categorizeByGroup": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "enumMembersFormat": "table",
  "typeDeclarationFormat": "table",

  "modifierTags": ["@internal", "@experimental", "@private", "@public", "@description"],
  "notRenderedTags": ["@internal"],

  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  }
}
